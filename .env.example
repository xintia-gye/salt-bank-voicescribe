# ─── Databricks ───────────────────────────────────────────────
DATABRICKS_HOST=https://adb-984752964297111.11.azuredatabricks.net
DATABRICKS_TOKEN=          # do NOT commit a real token
DATABRICKS_CATALOG=salt_bank_voicescribe
DATABRICKS_SCHEMA=voicescribe
DATABRICKS_WAREHOUSE_ID=148ccb90800933a1   # Shared Endpoint (X-Large)

# ─── Ingestion adapter ───────────────────────────────────────
# synthetic = replay TTS recordings in data/synthetic (default, no account needed)
# twilio    = receive real Twilio Voice recording webhooks
INGEST_ADAPTER=synthetic

# ─── Twilio (only needed when INGEST_ADAPTER=twilio) ─────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_SECRET=

# ─── Model serving ───────────────────────────────────────────
STT_ENDPOINT_NAME=voicescribe-whisper-stt
AGENT_ENDPOINT_NAME=voicescribe-summarization-agent

# ─── Lakebase ────────────────────────────────────────────────
LAKEBASE_INSTANCE=voicescribe-oltp
LAKEBASE_DATABASE=voicescribe
